+func TestClosedInstanceCanCloseSaturatedExecutorStream(t *testing.T) {
+	host := New()
+	instance := &hostCallbackInstance{}
+	ctx := withHostCallbackIdentity(context.Background(), "stream-plugin", instance)
+	streamID, _, cleanup := host.streams.open(context.Background())
+	defer cleanup()
+	rawEmit, _ := json.Marshal(rpcStreamEmitRequest{StreamID: streamID, Payload: []byte("chunk")})
+	for range streamBridgeBufferSize {
+		if _, err := host.callFromPlugin(ctx, pluginabi.MethodHostStreamEmit, rawEmit); err != nil {
+			t.Fatal(err)
+		}
+	}
+	notifyCtx := &streamBridgeNotifyContext{Context: ctx, ready: make(chan struct{})}
+	emitDone := make(chan error, 1)
+	go func() {
+		_, err := host.callFromPlugin(notifyCtx, pluginabi.MethodHostStreamEmit, rawEmit)
+		emitDone <- err
+	}()
+	select {
+	case <-notifyCtx.ready:
+	case <-time.After(time.Second):
+		t.Fatal("emit never reached saturated queue")
+	}
+	host.closeHostHTTPCallbackInstance("stream-plugin", instance)
+	if _, err := host.callFromPlugin(ctx, pluginabi.MethodHostStreamEmit, rawEmit); err == nil {
+		t.Fatal("closed instance accepted new output")
+	}
+	rawClose, _ := json.Marshal(rpcStreamCloseRequest{StreamID: streamID})
+	if _, err := host.callFromPlugin(ctx, pluginabi.MethodHostStreamClose, rawClose); err != nil {
+		t.Fatalf("shutdown cleanup rejected: %v", err)
+	}
+	select {
+	case err := <-emitDone:
+		if err == nil {
+			t.Fatal("saturated emit succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("shutdown did not release pending callback")
+	}
+}
